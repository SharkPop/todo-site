# --- Зависимости Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Базы данных SQLite ---
# Исключаем локальную базу, чтобы не залить данные пользователей в GitHub
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Секреты и переменные окружения ---
# Никогда не коммитьте файлы с паролями и токенами!
.env
.env.local
.env.*.local

# --- Системный мусор и IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Логи и временные файлы ---
logs/
*.log
tmp/
temp/